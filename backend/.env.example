# AITestAgent 后端环境变量示例：复制为 .env 后按需修改

# 应用信息
APP_NAME=AITestAgent
APP_VERSION=0.1.0
DEBUG=true

# 数据库连接（本地开发；容器内使用 docker-compose 注入）
DATABASE_URL=mysql+pymysql://aitest:aitest123456@127.0.0.1:3306/aitest_agent?charset=utf8mb4

# JWT 密钥（第二阶段登录功能使用，生产环境务必修改）
SECRET_KEY=please-change-me-in-production

# CORS 允许的前端来源（JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]

# AI 大模型配置（第五阶段 AI Agent 使用）
# AI_PROVIDER 可选：openai / deepseek / demo（demo 无需密钥，返回示例结果）
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 敏感信息加密密钥（可选；留空时由 SECRET_KEY 派生）
FERNET_KEY=
